source "https://rubygems.org"

# Same Jekyll and Markdown versions as GitHub Pages (https://pages.github.com/versions/).
# We don't depend on the `github-pages` gem: it doesn't support Ruby 4 and
# silently resolves to an outdated, broken Jekyll there.
gem "jekyll", "~> 3.10.0"
gem "kramdown", "~> 2.4.0"
gem "kramdown-parser-gfm"
gem "webrick"

# No longer default gems in recent Ruby versions (3.4+, 4.0), but needed by Jekyll 3.
gem "base64"
gem "bigdecimal"
gem "csv"
gem "logger"
gem "ostruct"
